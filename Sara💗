<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Galaxia de Amor</title>
<style>
  html, body {
    margin: 0; padding: 0; width: 100%; height: 100%;
    background: #05000a;
    overflow: hidden;
    font-family: Georgia, 'Times New Roman', serif;
    -webkit-user-select: none; user-select: none;
    touch-action: none;
  }
  #stage {
    position: relative;
    width: 100%; height: 100vh;
    display: flex; align-items: center; justify-content: center;
    background: #05000a;
  }
  #frame {
    position: relative;
    width: min(92vw, 480px);
    height: min(92vh, 854px);
    background: #020005;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 0 60px rgba(255,0,120,0.25);
  }
  .bokeh {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,20,120,0.9), rgba(255,20,120,0) 70%);
    filter: blur(6px);
    z-index: 0;
    pointer-events: none;
  }
  canvas { position: absolute; top:0; left:0; z-index: 1; cursor: grab; }
  canvas:active { cursor: grabbing; }
  #title {
    position: absolute;
    top: 22px; left: 0; right: 0;
    text-align: center;
    z-index: 5;
    color: #ffe6f0;
    font-style: italic;
    font-size: clamp(20px, 5.6vw, 28px);
    text-shadow: 0 0 18px rgba(255,60,140,0.9), 0 0 40px rgba(255,60,140,0.5);
    letter-spacing: 1px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1s ease;
  }
  #hint {
    position: absolute;
    bottom: 16px; left: 0; right: 0;
    text-align: center;
    z-index: 5;
    color: rgba(255,220,235,0.65);
    font-style: italic;
    font-size: 11.5px;
    letter-spacing: 0.3px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.5s ease;
  }
  #loveCount {
    position: absolute;
    top: 62px; left: 0; right: 0;
    text-align: center;
    z-index: 5;
    color: rgba(255,190,220,0.85);
    font-size: 11px;
    letter-spacing: 1px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .floatText {
    position: absolute;
    z-index: 4;
    font-style: italic;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    text-shadow: 0 0 10px currentColor, 0 0 20px currentColor;
    transition: opacity 1.2s ease, transform 3.2s ease;
  }
  #tapLayer {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    z-index: 6; cursor: pointer;
    transition: opacity 0.8s ease;
  }
  #tapHeart {
    width: 90px; height: 90px;
    filter: drop-shadow(0 0 20px rgba(255,40,130,0.9)) drop-shadow(0 0 45px rgba(255,40,130,0.6));
    animation: pulse 1.4s ease-in-out infinite;
  }
  #tapText {
    margin-top: 18px;
    color: rgba(255,220,235,0.85);
    font-style: italic;
    font-size: 16px;
    text-shadow: 0 0 10px rgba(255,100,160,0.6);
  }
  #tapHand {
    position: absolute;
    width: 34px; height: 34px;
    left: 50%; top: 50%;
    margin-left: 6px; margin-top: 34px;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.6));
    animation: tapMove 1.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,100% { transform: scale(1); }
    50% { transform: scale(1.12); }
  }
  @keyframes tapMove {
    0%,100% { transform: translate(0,0) scale(1); }
    45% { transform: translate(-4px,-4px) scale(0.92); }
    55% { transform: translate(-4px,-4px) scale(0.92); }
  }
</style>
</head>
<body>
<div id="stage">
  <div id="frame">
    <div class="bokeh" style="width:140px;height:140px; top:-40px; left:-30px;"></div>
    <div class="bokeh" style="width:100px;height:100px; top:20px; right:-30px;"></div>
    <div class="bokeh" style="width:160px;height:160px; bottom:-50px; right:-40px;"></div>
    <div class="bokeh" style="width:110px;height:110px; bottom:-20px; left:-30px;"></div>

    <canvas id="canvas"></canvas>
    <div id="title">Te Amo ❤️</div>
    <div id="loveCount"></div>
    <div id="floatLayer"></div>
    <div id="hint">Toca el corazón para llenarlo de amor · arrastra para girar · toca la galaxia para dejar un mensaje</div>

    <div id="tapLayer">
      <svg id="tapHeart" viewBox="0 0 32 29">
        <path fill="#ff2d78" d="M16 29 2.6 16.6C-1 13.1-1 7.2 2.9 3.9 6.4.9 11.6 1.5 14.7 5l1.3 1.4L17.3 5c3.1-3.5 8.3-4.1 11.8-1.1 3.9 3.3 3.9 9.2.3 12.7L16 29z"/>
      </svg>
      <svg id="tapHand" viewBox="0 0 24 24">
        <path fill="#ffffff" stroke="#000" stroke-width="0.5" d="M9 2a1.5 1.5 0 0 1 1.5 1.5V11h.4V4.5a1.5 1.5 0 0 1 3 0V11h.4V6a1.4 1.4 0 0 1 2.8 0v5.2h.3a1.3 1.3 0 0 1 2.6.2v5.1c0 3-2.4 5.5-5.5 5.5h-2c-2 0-3.2-.6-4.4-2l-3-3.6c-.6-.8-.4-1.7.3-2.2.6-.5 1.5-.4 2.1.2l1.5 1.6V3.5A1.5 1.5 0 0 1 9 2z"/>
      </svg>
      <div id="tapText">Toca para revelar</div>
    </div>
  </div>
</div>

<script>
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
const frame = document.getElementById('frame');
const tapLayer = document.getElementById('tapLayer');
const title = document.getElementById('title');
const hint = document.getElementById('hint');
const loveCountEl = document.getElementById('loveCount');
const floatLayer = document.getElementById('floatLayer');

function resize() {
  canvas.width = frame.clientWidth;
  canvas.height = frame.clientHeight;
}
resize();
window.addEventListener('resize', resize);
const W = () => canvas.width;
const H = () => canvas.height;

// ---------- Stars ----------
const stars = Array.from({length: 90}, () => ({
  x: Math.random(), y: Math.random(),
  r: Math.random()*1.4 + 0.3,
  phase: Math.random()*Math.PI*2
}));

// ---------- Galaxy particles (log spiral arms) ----------
const ARMS = 3;
const PARTICLES_PER_ARM = 240;
let galaxy = [];
function buildGalaxy() {
  galaxy = [];
  for (let arm = 0; arm < ARMS; arm++) {
    const armOffset = (arm / ARMS) * Math.PI * 2;
    for (let i = 0; i < PARTICLES_PER_ARM; i++) {
      const t = i / PARTICLES_PER_ARM;
      const angle = t * Math.PI * 3.2 + armOffset;
      const radius = t * 1.0;
      const jitterA = (Math.random()-0.5) * 0.35 * (1-t*0.6);
      const jitterR = (Math.random()-0.5) * 0.05;
      const colorRoll = Math.random();
      let color;
      if (colorRoll < 0.5) color = 'rgba(255,160,205,ALPHA)';
      else if (colorRoll < 0.8) color = 'rgba(255,90,170,ALPHA)';
      else color = 'rgba(220,180,255,ALPHA)';
      galaxy.push({
        angle: angle + jitterA, radius: radius + jitterR,
        size: Math.random()*1.8 + 0.5, color: color,
        twinkle: Math.random()*Math.PI*2
      });
    }
  }
}
buildGalaxy();

// ---------- Heart-outline core particles ----------
const HEART_POINTS = (() => {
  const pts = [];
  const N = 90;
  for (let i = 0; i < N; i++) {
    const t = (i / N) * Math.PI * 2;
    const x = 16 * Math.pow(Math.sin(t), 3);
    const y = -(13*Math.cos(t) - 5*Math.cos(2*t) - 2*Math.cos(3*t) - Math.cos(4*t));
    pts.push({x: x/16, y: y/16});
  }
  return pts;
})();

// ---------- Sub-decorative sprite icons (generic, non-branded) ----------
const decorEmojis = ['✨','💫','🌸','💗','⭐'];
let decorSprites = [];
function buildDecor() {
  decorSprites = [];
  const count = 10;
  for (let i=0;i<count;i++) {
    const arm = i % ARMS;
    const t = 0.25 + Math.random()*0.7;
    decorSprites.push({
      arm, t,
      angleOffset: (arm/ARMS)*Math.PI*2,
      emoji: decorEmojis[Math.floor(Math.random()*decorEmojis.length)],
      bob: Math.random()*Math.PI*2,
      size: 14 + Math.random()*6
    });
  }
}
buildDecor();

// ---------- State ----------
let mode = 'idle';
let burstStart = 0;
let galaxyRotation = 0;
let galaxyScale = 0;
let dragVelocity = 0.0016;
let isDragging = false;
let lastPointerX = 0;
let heartBeat = 0;
let heartExtraPulse = 0;
let loveLevel = 0;
let sparkles = [];
let miniHearts = [];
let burstParticles = [];

const phrases = [
  "Mi cielo favorito","Te Amo","Eres mi paz","Mi historia favorita",
  "Mi gravedad eres tú","Mi mayor suerte","Contigo todo brilla",
  "Eres mi calma","Mi universo eres tú","Todo comenzó contigo",
  "Eres mi hogar","Mi luz de cada día","Gracias por existir","Mi persona favorita",
  "Nuestro tiempo","Mi mejor decisión"
];
const phraseColors = ['#ffdfe9','#ffd27a','#c9a8ff','#ff8fbf'];

function spawnFloatingText(xPct, yPct, text) {
  const el = document.createElement('div');
  el.className = 'floatText';
  el.textContent = text || phrases[Math.floor(Math.random()*phrases.length)];
  const color = phraseColors[Math.floor(Math.random()*phraseColors.length)];
  el.style.color = color;
  el.style.fontSize = (11 + Math.random()*8) + 'px';
  el.style.left = xPct + '%';
  el.style.top = yPct + '%';
  floatLayer.appendChild(el);
  requestAnimationFrame(() => {
    el.style.opacity = '0.95';
    el.style.transform = `translateY(-16px)`;
  });
  setTimeout(() => { el.style.opacity = '0'; }, 2600);
  setTimeout(() => { el.remove(); }, 4000);
}
let floatInterval = null;

function heartPath(cx, cy, size) {
  ctx.beginPath();
  const topCurveHeight = size * 0.3;
  ctx.moveTo(cx, cy + topCurveHeight);
  ctx.bezierCurveTo(cx, cy, cx - size/2, cy, cx - size/2, cy + topCurveHeight);
  ctx.bezierCurveTo(cx - size/2, cy + (size+topCurveHeight)/2, cx, cy + (size+topCurveHeight)/1.35, cx, cy + size);
  ctx.bezierCurveTo(cx, cy + (size+topCurveHeight)/1.35, cx + size/2, cy + (size+topCurveHeight)/2, cx + size/2, cy + topCurveHeight);
  ctx.bezierCurveTo(cx + size/2, cy, cx, cy, cx, cy + topCurveHeight);
  ctx.closePath();
}

function drawGlow(cx, cy, radius, alpha, color) {
  if (alpha <= 0) return;
  const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, radius);
  grad.addColorStop(0, `rgba(${color},${alpha})`);
  grad.addColorStop(0.5, `rgba(${color},${alpha*0.45})`);
  grad.addColorStop(1, `rgba(${color},0)`);
  ctx.fillStyle = grad;
  ctx.beginPath();
  ctx.arc(cx, cy, radius, 0, Math.PI*2);
  ctx.fill();
}

function heartHit(px, py) {
  const cx = W()/2, cy = H()*0.5;
  const d = Math.hypot(px-cx, py-cy);
  return d < 40 + loveLevel*1.2;
}

function burstSparkles(x, y, count, color) {
  for (let i=0; i<count; i++) {
    const a = Math.random()*Math.PI*2;
    const speed = 1 + Math.random()*4;
    sparkles.push({x,y, vx: Math.cos(a)*speed, vy: Math.sin(a)*speed, life:1, size: Math.random()*2+1, color});
  }
}
function releaseMiniHeart() {
  const cx = W()/2, cy = H()*0.5;
  const a = Math.random()*Math.PI*2;
  const speed = 0.8 + Math.random()*1.4;
  miniHearts.push({x:cx, y:cy, vx: Math.cos(a)*speed, vy: Math.sin(a)*speed - 0.3, life:1, size: 6+Math.random()*6});
}

function triggerBurst() {
  mode = 'burst';
  burstStart = performance.now();
  const cx = W()/2, cy = H()*0.42;
  burstParticles = Array.from({length: 140}, () => {
    const a = Math.random()*Math.PI*2;
    const speed = 2 + Math.random()*6;
    return { x: cx, y: cy, vx: Math.cos(a)*speed, vy: Math.sin(a)*speed, size: Math.random()*2.5+1, life: 1 };
  });
  setTimeout(() => {
    mode = 'galaxy';
    title.style.opacity = '1';
    hint.style.opacity = '1';
    floatInterval = setInterval(() => spawnFloatingText(10 + Math.random()*70, 38 + Math.random()*34), 700);
  }, 900);
}

function pointerPos(e) {
  const rect = canvas.getBoundingClientRect();
  const t = e.touches ? e.touches[0] : e;
  return { x: (t.clientX - rect.left), y: (t.clientY - rect.top) };
}
let downX=0, downY=0, moved=false;

tapLayer.addEventListener('click', () => {
  if (mode !== 'idle') return;
  tapLayer.style.opacity = '0';
  setTimeout(() => tapLayer.style.display = 'none', 800);
  triggerBurst();
});

canvas.addEventListener('pointerdown', (e) => {
  if (mode !== 'galaxy') return;
  const p = pointerPos(e);
  isDragging = true; lastPointerX = p.x; downX = p.x; downY = p.y; moved = false;
});
canvas.addEventListener('pointermove', (e) => {
  if (!isDragging) return;
  const p = pointerPos(e);
  const dx = p.x - lastPointerX;
  if (Math.abs(p.x-downX) > 4 || Math.abs(p.y-downY) > 4) moved = true;
  galaxyRotation += dx * 0.006;
  lastPointerX = p.x;
});
window.addEventListener('pointerup', (e) => {
  if (!isDragging) return;
  isDragging = false;
  if (mode !== 'galaxy') return;
  const p = pointerPos(e);
  if (!moved) handleTap(p.x, p.y);
});

function handleTap(x, y) {
  hint.style.opacity = '0.4';
  if (heartHit(x, y)) {
    heartExtraPulse = 1;
    loveLevel = Math.min(loveLevel + 3, 40);
    loveCountEl.style.opacity = '1';
    loveCountEl.textContent = '♡ '.repeat(Math.min(1 + Math.floor(loveLevel/8), 6));
    for (let i=0;i<3;i++) releaseMiniHeart();
    burstSparkles(x, y, 24, '255,120,180');
    spawnFloatingText(50, 50, phrases[Math.floor(Math.random()*phrases.length)]);
  } else {
    burstSparkles(x, y, 14, '255,180,220');
    spawnFloatingText((x/W())*100, (y/H())*100);
  }
}

function draw(now) {
  ctx.clearRect(0,0,W(),H());

  const g = ctx.createRadialGradient(W()/2,H()*0.55,0, W()/2,H()*0.55, Math.max(W(),H())*0.75);
  g.addColorStop(0,'#180014');
  g.addColorStop(1,'#020005');
  ctx.fillStyle = g;
  ctx.fillRect(0,0,W(),H());

  stars.forEach(s => {
    const tw = 0.5 + 0.5*Math.sin(now*0.002 + s.phase);
    ctx.globalAlpha = 0.3 + tw*0.5;
    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.arc(s.x*W(), s.y*H(), s.r, 0, Math.PI*2);
    ctx.fill();
  });
  ctx.globalAlpha = 1;

  if (mode === 'burst') {
    const cx = W()/2, cy = H()*0.42;
    const elapsed = now - burstStart;
    const heartAlpha = Math.max(0, 1 - elapsed/700);
    drawGlow(cx, cy, 34*2.2, heartAlpha, '255,50,130');
    burstParticles.forEach(p => {
      p.x += p.vx; p.y += p.vy;
      p.vx *= 0.96; p.vy *= 0.96;
      p.life -= 0.02;
      if (p.life > 0) {
        ctx.globalAlpha = p.life;
        ctx.fillStyle = '#ff5fa8';
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI*2);
        ctx.fill();
      }
    });
    ctx.globalAlpha = 1;
  }

  if (mode === 'galaxy') {
    galaxyScale = Math.min(1, galaxyScale + 0.012);
    if (!isDragging) galaxyRotation += dragVelocity;
    heartBeat += 0.045;
    heartExtraPulse *= 0.94;

    const cx = W()/2, cy = H()*0.5;
    const maxR = Math.min(W(),H()) * 0.42 * galaxyScale;

    galaxy.forEach(p => {
      const a = p.angle + galaxyRotation;
      const r = p.radius * maxR;
      const x = cx + Math.cos(a) * r;
      const y = cy + Math.sin(a) * r * 0.5;
      const tw = 0.5 + 0.5*Math.sin(now*0.003 + p.twinkle);
      const alpha = (0.25 + tw*0.55) * galaxyScale;
      ctx.fillStyle = p.color.replace('ALPHA', alpha.toFixed(2));
      ctx.beginPath();
      ctx.arc(x, y, p.size, 0, Math.PI*2);
      ctx.fill();
    });

    decorSprites.forEach(d => {
      const a = d.t * Math.PI * 3.2 + d.angleOffset + galaxyRotation;
      const r = d.t * maxR;
      const bobY = Math.sin(now*0.0015 + d.bob) * 4;
      const x = cx + Math.cos(a) * r;
      const y = cy + Math.sin(a) * r * 0.5 + bobY;
      ctx.globalAlpha = 0.85 * galaxyScale;
      ctx.font = `${d.size}px serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(d.emoji, x, y);
    });
    ctx.globalAlpha = 1;

    sparkles = sparkles.filter(s => s.life > 0);
    sparkles.forEach(s => {
      s.x += s.vx; s.y += s.vy;
      s.vx *= 0.95; s.vy *= 0.95;
      s.life -= 0.025;
      ctx.globalAlpha = Math.max(s.life,0);
      ctx.fillStyle = `rgb(${s.color})`;
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.size, 0, Math.PI*2);
      ctx.fill();
    });
    ctx.globalAlpha = 1;

    miniHearts = miniHearts.filter(h => h.life > 0);
    miniHearts.forEach(h => {
      h.x += h.vx; h.y += h.vy; h.vy -= 0.01;
      h.life -= 0.012;
      ctx.globalAlpha = Math.max(h.life,0);
      ctx.fillStyle = '#ff5d9e';
      heartPath(h.x, h.y, h.size);
      ctx.fill();
    });
    ctx.globalAlpha = 1;

    const beat = 1 + Math.sin(heartBeat)*0.07 + heartExtraPulse*0.4;
    const coreSize = (24 + loveLevel*0.7) * beat * galaxyScale;

    drawGlow(cx, cy, coreSize*2.6, (0.5 + heartExtraPulse*0.3)*galaxyScale, '255,50,130');

    ctx.save();
    ctx.shadowColor = 'rgba(255,60,140,0.95)';
    ctx.shadowBlur = 14;
    HEART_POINTS.forEach((pt, i) => {
      const x = cx + pt.x * coreSize;
      const y = cy + pt.y * coreSize;
      const tw = 0.6 + 0.4*Math.sin(now*0.006 + i);
      ctx.globalAlpha = tw * galaxyScale;
      ctx.fillStyle = '#ff2d78';
      ctx.beginPath();
      ctx.arc(x, y, 1.6, 0, Math.PI*2);
      ctx.fill();
    });
    ctx.restore();
    ctx.globalAlpha = 1;
  }

  requestAnimationFrame(draw);
}

requestAnimationFrame(draw);
</script>
</body>
</html>
